# --- GymCast backend env (copy to backend/.env) ---

# MongoDB Atlas connection string (must be a replica set for Change Streams — Atlas is by default)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/gymcast?retryWrites=true&w=majority

# OpenAI (used ONLY for the final goal-resolution oracle verdict)
OPENAI_API_KEY=sk-...
# Vision model for the high-stakes verdict
OPENAI_VISION_MODEL=gpt-5
# Cheap model for optional ticker commentary
OPENAI_COMMENTARY_MODEL=gpt-4o

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
# Deployed Anchor program id (from Solana Playground deploy)
PROGRAM_ID=
# Base58 or JSON-array secret key for the oracle/authority keypair (devnet, funded). NEVER commit.
AUTHORITY_SECRET_KEY=

# Server
PORT=5000
# Comma-separated allowed CORS origins
CORS_ORIGIN=http://localhost:3000

# Optional: Vultr-hosted ensemble vision model endpoint (second-opinion oracle)
VULTR_VISION_URL=
